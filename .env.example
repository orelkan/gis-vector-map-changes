# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. All values below are placeholders, not real secrets.

# --- Airflow container/user setup ---
# On Linux, set this to your host UID (`id -u`) so mounted volumes aren't
# root-owned. Leave as-is on macOS/Windows Docker Desktop.
AIRFLOW_UID=50000

# Fernet key used by Airflow to encrypt Connection passwords at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme-generate-a-real-fernet-key

# Local-dev-only Airflow UI admin account.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=changeme

# --- Application database (PostGIS) ---
# Separate from Airflow's own metadata database -- this is where the
# `snapshots` table (and later, matching results) live.
GIS_DB_NAME=gis
GIS_DB_USER=gis
GIS_DB_PASSWORD=changeme

# --- MinIO (S3-compatible object storage for snapshot files) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-min-8-chars
MINIO_BUCKET=gis-vector-map-changes

# --- Airflow Connection names ---
# Not credentials -- these just name the Connections that airflow-init
# creates (see docker-compose.yml) from the credentials above. The DAG
# looks up connections by these same names (falls back to these exact
# values if unset, so this section is optional for local dev). Useful if
# you ever run this DAG against an Airflow instance where connections of
# these names already exist under different names (e.g. a shared
# staging/prod Airflow), without editing DAG code.
MINIO_AIRFLOW_CONN_ID=minio_default
GIS_POSTGRES_AIRFLOW_CONN_ID=gis_postgres_default
